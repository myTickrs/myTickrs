# Copy to .env and adjust. .env is git-ignored.

# --- Server ---
# NODE_ENV=development
HOST=127.0.0.1
PORT=5051
# The web dev server (npm run dev), which proxies /api to PORT.
WEB_PORT=5050
LOG_LEVEL=info
# Every logged error is also written to errors-YYYY-MM-DD.log (local date) in this folder,
# relative to the repository root; empty: no file. Files older than ERROR_LOG_DAYS are deleted.
ERROR_LOG_DIR=./logs
ERROR_LOG_DAYS=30

# --- Database: SQLite, and only SQLite (architecture D3) ---
# Relative paths are resolved from the repository root.
SQLITE_PATH=./data/tickrs.db


# --- Encryption of stored provider keys (AES-256-GCM, base64 of 32 bytes) ---
# When unset, one is generated once and kept in ./data/.master-key beside the database.
# KEY_ENCRYPTION_KEY=

# CLOUD_URL=https://mytickrs.app
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_CLIENT_ID=
